#pragma kernel Sample

Texture2DArray<float> _Depth;          // _EnvironmentDepthTexture (слои = глаза)
RWStructuredBuffer<float4> _Points;    // xyz = мировая точка, w = расстояние от головы (0 = нет данных)

float4x4 _InvVP;       // обратная матрица репроекции глубинной камеры
float4x4 _VP;          // сама матрица (мир -> клип глубинной камеры)
float4   _ZBuf;        // _EnvironmentDepthZBufferParams
float4   _CamPos;      // позиция головы
int      _GridW, _GridH;
int      _DepthW, _DepthH;
int      _Slice;
int      _BaseIndex;   // начало текущего кадра в кольцевом буфере истории
int      _FlipY;
// 0: z=d  1: z=2d-1  2: z=1-d  3: z=2(1-d)-1   (глубина = NDC-z, обратная матрица)
// 4: eye=x/((2d-1)+y)  5: eye=x/(d+y)  6: eye=1/(x*d+y)  7: eye=1/(x*(1-d)+y)   (линейная глубина + только xy-строки матрицы)
int      _ZMode;
float2   _Jitter;      // сдвиг сетки внутри ячейки, меняется каждый кадр
float    _MinDist, _MaxDist;

[numthreads(8, 8, 1)]
void Sample(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GridW || id.y >= (uint)_GridH) return;
    uint idx = id.y * (uint)_GridW + id.x;

    float2 uv = (float2(id.xy) + _Jitter) / float2(_GridW, _GridH);
    int2 px = clamp(int2(uv * float2(_DepthW, _DepthH)), int2(0, 0), int2(_DepthW - 1, _DepthH - 1));

    float d = _Depth.Load(int4(px, _Slice, 0));

    float2 uvc = (float2(px) + 0.5) / float2(_DepthW, _DepthH);
    float2 ndc = float2(uvc.x, _FlipY != 0 ? 1.0 - uvc.y : uvc.y) * 2.0 - 1.0;

    float3 p;
    bool okz = true;

    if (_ZMode >= 4)
    {
        // Линейная глубина zl (расстояние вдоль оси камеры = clip.w). Точку ищем из трёх линейных уравнений:
        // (r0 - ndc.x*r3)·P = -(r0.w - ndc.x*r3.w), (r1 - ndc.y*r3)·P = ..., r3·P = zl - r3.w. Строка z матрицы не нужна.
        float x = _ZBuf.x, y = _ZBuf.y;
        float zl;
        if (_ZMode == 4)      zl = x / ((2.0 * d - 1.0) + y);
        else if (_ZMode == 5) zl = x / (d + y);
        else if (_ZMode == 6) zl = 1.0 / (x * d + y);
        else                  zl = 1.0 / (x * (1.0 - d) + y);

        float4 r0 = _VP[0], r1 = _VP[1], r3 = _VP[3];
        float3 a = r0.xyz - ndc.x * r3.xyz;
        float3 b = r1.xyz - ndc.y * r3.xyz;
        float3 c = r3.xyz;
        float3 rhs = float3(-(r0.w - ndc.x * r3.w), -(r1.w - ndc.y * r3.w), zl - r3.w);
        float det = dot(a, cross(b, c));
        okz = abs(det) > 1e-9 && zl > 0.0 && isfinite(zl);
        p = (rhs.x * cross(b, c) + rhs.y * cross(c, a) + rhs.z * cross(a, b)) / det;
    }
    else
    {
        float z = d;
        if (_ZMode == 1) z = 2.0 * d - 1.0;
        else if (_ZMode == 2) z = 1.0 - d;
        else if (_ZMode == 3) z = 2.0 * (1.0 - d) - 1.0;

        float4 w = mul(_InvVP, float4(ndc, z, 1.0));
        okz = abs(w.w) > 1e-6;
        p = w.xyz / w.w;
    }

    float dist = distance(p, _CamPos.xyz);

    bool ok = okz && (d > 0.0) && (d < 1.0) && isfinite(dist)
              && dist > _MinDist && dist < _MaxDist;

    _Points[_BaseIndex + idx] = ok ? float4(p, dist) : float4(0, 0, 0, 0);
}
